{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "plugixa-testimonial/testimonial-display",
    "version": "1.1.1",
    "title": "Plugixa Testimonials",
    "category": "widgets",
    "icon": "star-filled",
    "description": "Display testimonials from PlugixaTestimonial plugin with customizable layouts and filters.",
    "keywords": ["testimonial", "review", "rating", "plugixa"],
    "supports": {
        "align": ["wide", "full"],
        "className": true,
        "html": false
    },
    "textdomain": "plugixa-testimonial",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "attributes": {
        "mode": {
            "type": "string",
            "default": "existing"
        },
        "shortcodeId": {
            "type": "number",
            "default": 0
        },
        "viewId": {
            "type": "number",
            "default": 0
        },
        "category": {
            "type": "string",
            "default": ""
        },
        "limit": {
            "type": "number",
            "default": 0
        },
        "orderby": {
            "type": "string",
            "default": "display_order"
        },
        "order": {
            "type": "string",
            "default": "ASC"
        },
        "featuredOnly": {
            "type": "boolean",
            "default": false
        },
        "minRating": {
            "type": "number",
            "default": 0
        },
        "showPhoto": {
            "type": "boolean",
            "default": true
        },
        "showRating": {
            "type": "boolean",
            "default": true
        },
        "showRole": {
            "type": "boolean",
            "default": true
        },
        "showCompany": {
            "type": "boolean",
            "default": true
        },
        "showDate": {
            "type": "boolean",
            "default": true
        },
        "showWebsite": {
            "type": "boolean",
            "default": true
        },
        "showQuoteIcon": {
            "type": "boolean",
            "default": true
        }
    }
}
